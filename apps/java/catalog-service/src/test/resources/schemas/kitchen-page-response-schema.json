{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "content": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "name"],
        "additionalProperties": false
      }
    },
    "page": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "number": {
          "type": "integer",
          "minimum": 0
        },
        "total_elements": {
          "type": "integer",
          "minimum": 0
        },
        "total_pages": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["size", "number", "total_elements", "total_pages"],
      "additionalProperties": false
    }
  },
  "required": ["content", "page"],
  "additionalProperties": false
}