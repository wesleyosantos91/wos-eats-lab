{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "name": {
      "type": "string"
    },
    "kitchen_id": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "kitchen_name": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "delivery_fee": {
      "type": "number"
    }
  },
  "required": ["id", "name", "kitchen_id", "active", "delivery_fee"],
  "additionalProperties": false
}